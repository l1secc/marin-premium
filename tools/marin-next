#!/bin/bash

# omarchy:summary=Cycle Marin Premium photo palettes (one theme, all photos)
# omarchy:args=[next|prev|sync|<num>|<name>]
# omarchy:examples=marin-next | marin-next prev | marin-next 20 | marin-next sync

# All Marin photos live under the single `marin-premium` theme. Each photo has
# a pre-generated palette bundle in palettes/<num>-<slug>/. Switching means:
#   1. copy that bundle's colors.toml/shell.toml/waybar.css/hyprland.conf to the
#      theme root (so the whole desktop is retinted from that one photo), then
#   2. re-apply the theme, so omarchy regenerates every terminal / editor / bar /
#      menu / launcher / lock config from the new palette, then
#   3. pin the matching wallpaper.
#
# `sync` re-aligns the palette with whatever background is currently active, so
# after using omarchy's own `theme bg next` you can run `marin-next sync`.

set -euo pipefail

THEME="marin-premium"
THEME_DIR="$HOME/.config/omarchy/themes/$THEME"
PALETTES_DIR="$THEME_DIR/palettes"
BACKGROUNDS_DIR="$THEME_DIR/backgrounds"
STAGED_BG_DIR="$HOME/.local/state/omarchy/current/theme/backgrounds"
CURRENT_BG_LINK="$HOME/.local/state/omarchy/current/background"

mapfile -t BUNDLES < <(find "$PALETTES_DIR" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | sort)
COUNT=${#BUNDLES[@]}
if (( COUNT == 0 )); then
  echo "No palette bundles found in $PALETTES_DIR" >&2
  exit 1
fi

json_field() { # json_field <file> <key>
  python3 -c 'import json,sys;print(json.load(open(sys.argv[1])).get(sys.argv[2],""))' "$1" "$2" 2>/dev/null || true
}

bundle_wall()  { json_field "$1/meta.json" wallpaper; }
bundle_title() { json_field "$1/meta.json" title; }

CURRENT=$(basename "$(readlink -f "$CURRENT_BG_LINK" 2>/dev/null)" 2>/dev/null || true)
INDEX=-1
for i in "${!BUNDLES[@]}"; do
  if [[ "$(bundle_wall "${BUNDLES[$i]}")" == "$CURRENT" ]]; then INDEX=$i; break; fi
done

ARG="${1:-next}"
TARGET=-1
case "$ARG" in
  "" | next)          TARGET=$(( (INDEX + 1 + COUNT) % COUNT )) ;;
  prev | previous)    TARGET=$(( (INDEX - 1 + 2 * COUNT) % COUNT )) ;;
  sync)               TARGET=$(( INDEX >= 0 ? INDEX : 0 )) ;;
  [0-9]*)             TARGET=$(( 10#$ARG - 1 )) ;;
  *)
    for i in "${!BUNDLES[@]}"; do
      [[ "${BUNDLES[$i]##*/}" == *"$ARG"* ]] && { TARGET=$i; break; }
    done
    ;;
esac

# Unknown current photo and no explicit target: start at the first bundle.
if (( INDEX == -1 && TARGET == -1 && ARG == "next" )); then TARGET=0; fi

if (( TARGET < 0 || TARGET >= COUNT )); then
  echo "No Marin photo matches: $ARG (have $(basename "${BUNDLES[0]}")…$(basename "${BUNDLES[$((COUNT-1))]}"))" >&2
  exit 1
fi

BUNDLE="${BUNDLES[$TARGET]}"
WALL=$(bundle_wall "$BUNDLE")
TITLE=$(bundle_title "$BUNDLE")
[[ -n "$WALL" ]] || { echo "Palette bundle $BUNDLE has no wallpaper in meta.json" >&2; exit 1; }
[[ -f "$BACKGROUNDS_DIR/$WALL" ]] || { echo "Missing wallpaper: $BACKGROUNDS_DIR/$WALL" >&2; exit 1; }

# 1. Install the photo's palette at the theme root (the active palette).
cp -f "$BUNDLE/colors.toml" "$THEME_DIR/colors.toml"
for f in shell.toml waybar.css hyprland.conf; do
  [[ -f "$BUNDLE/$f" ]] && cp -f "$BUNDLE/$f" "$THEME_DIR/$f"
done

# 2. Re-apply the theme so every generated config (terminal, editor, bar,
#    menus, launcher, lock) picks up the new palette.
omarchy-theme-set "$THEME"

# 3. Pin this photo as the wallpaper even if the theme's gallery staging chose
#    another one from backgrounds/.
if [[ -f "$STAGED_BG_DIR/$WALL" ]]; then
  omarchy-theme-bg-set "$STAGED_BG_DIR/$WALL"
fi

# 4. Notify with the photo itself.
if command -v omarchy-notification-send >/dev/null 2>&1; then
  omarchy-notification-send "Marin Premium · ${TITLE:-$WALL}" \
    "Foto + tüm teması değişti · $((TARGET + 1))/$COUNT" \
    --image "$BACKGROUNDS_DIR/$WALL" -t 2500 >/dev/null 2>&1 || true
fi

echo "Marin Premium → ${TITLE:-$WALL} ($((TARGET + 1))/$COUNT)"
